# Copy to .env.local and fill in. Never commit real secrets.

# WeatherUnlocked / WeatherUnlimited — Northstar / Martis Camp
WEATHER_APP_ID=
WEATHER_APP_KEY=
WEATHER_LOCATION_ZIP=96161
WEATHER_LAT=39.32
WEATHER_LON=-120.16

# Supabase — set both to switch the app from mock data to the live backend.
# Find them in the Supabase dashboard → Project Settings → API.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>

# --- Server-side only (Vercel env vars; never exposed to the browser) -------

# Supabase service role — bypasses RLS. Used by the WhatsApp functions only.
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret>
# SUPABASE_URL=https://<project-ref>.supabase.co

# WhatsApp assistant (api/whatsapp.js)
# ANTHROPIC_API_KEY=sk-ant-...
# WHATSAPP_AGENT_MODEL=claude-opus-5      # optional; blank means the code default
# WHATSAPP_AGENT_EFFORT=low               # optional; low | medium | high
# TWILIO_AUTH_TOKEN=<Twilio auth token>   # verifies inbound webhook signatures
# WHATSAPP_PUBLIC_URL=https://martis.camp/api/whatsapp

# Outbound invites (api/notify-invite.js). WhatsApp requires a Meta-approved
# content template for business-initiated messages — TWILIO_INVITE_CONTENT_SID
# is that template, from Twilio's Content Template Builder.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_WHATSAPP_FROM=+17752627847
# TWILIO_INVITE_CONTENT_SID=HX...
# INVITE_WEBHOOK_SECRET=<random string; also set as the x-webhook-secret header
#                        on the Supabase database webhook>
